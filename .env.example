# Build-time settings. Copy this file to .env, fill it in, then run or build with:
#
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#
# The values are compiled into the app (there is no settings screen). .env is git-ignored.

# The McpAi server the AI chat talks to (POST /api/chat, GET /api/health).
# Release builds need https://. Leave empty for the local dev server http://127.0.0.1:3000.
API_BASE_URL=https://mcpai-76u1.onrender.com

# Optional: sent as "Authorization: Bearer <token>" once the server adds authentication.
API_TOKEN=
